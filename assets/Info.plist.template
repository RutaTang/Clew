<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- __APP_NAME__ and __BUNDLE_ID__ are substituted by scripts/build-app.sh
       per flavor (prod / dev / test). The executable stays `clew`. -->
  <key>CFBundleName</key>
  <string>__APP_NAME__</string>
  <key>CFBundleDisplayName</key>
  <string>__APP_NAME__</string>
  <key>CFBundleIdentifier</key>
  <string>__BUNDLE_ID__</string>
  <key>CFBundleExecutable</key>
  <string>clew</string>
  <key>CFBundleIconFile</key>
  <string>clew</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <key>CFBundleVersion</key>
  <string>__BUILD__</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <!-- The languages clew speaks: macOS then shows its own parts of the app
       (the standard menu items, open panels, alerts) in the same one, and
       takes the microphone prompt from Resources/<lang>.lproj. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>fr</string>
    <string>zh-Hans</string>
    <string>ko</string>
    <string>ja</string>
  </array>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.developer-tools</string>
  <key>NSHumanReadableCopyright</key>
  <string>An Integrated Understand Environment helps you understand any codebase.</string>
  <!-- Voice: macOS asks the user before Clew first listens, with this text. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Clew listens when you press the voice key or the microphone button, so you can say a command or ask about the code. What you say is turned into text on this Mac and never leaves it.</string>
</dict>
</plist>
