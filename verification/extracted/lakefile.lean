import Lake
open Lake DSL

/-! The Rust code the models in `../Clew` describe, translated to Lean from
its own source by Charon and Aeneas (`ClewRules.lean`, generated by
`./extract.sh`, never edited by hand), and the proofs that it computes
exactly what those models compute (`Equal.lean`). So the theorems proved of
the models hold of the code that runs.

A project apart from `..` because Aeneas's library needs Mathlib, which the
models and their proofs do not. -/

package «clew-extracted» where
  leanOptions := #[⟨`autoImplicit, false⟩]

-- The Lean library of the Aeneas release whose `charon` and `aeneas`
-- `extract.sh` runs (nightly-2026.11.18-1dc8ad3), at that commit.
require aeneas from git
  "https://github.com/AeneasVerif/aeneas.git" @ "1dc8ad31b1b062a77c50e29144a6c7bba955fa09" / "backends/lean"

require «clew-verification» from ".."

/-- What Aeneas made of `crates/clew-rules`. -/
lean_lib ClewRules {}

/-- The extracted functions are the models. -/
@[default_target] lean_lib Equal where
  leanOptions := #[⟨`warningAsError, true⟩]
