def voice.route
  (f : voice.RouteFacts) : Result (alloc.vec.Vec voice.Step) := do
  if f.bye
  then voice.only voice.Step.Bye
  else
    if f.stop_listening_said
    then voice.only voice.Step.SayHowToStop
    else
      if f.empty
      then voice.only voice.Step.Nothing
      else
        if f.confirm_waiting
        then
          let answer ← if f.hush
                         then ok (some false)
                         else ok f.yes_or_no
          match answer with
          | none =>
            let (o, offers_answer) ←
              match f.to_question with
              | none => ok (none, false)
              | some qw =>
                do
                let b ←
                  match qw with
                  | voice.QuestionWord.YesOrNo => ok false
                  | voice.QuestionWord.Answer => ok true
                ok (f.to_question, b)
            let hush ← if f.hush
                         then ok (¬ offers_answer)
                         else ok false
            if hush
            then
              if f.answer_being_written
              then voice.only voice.Step.Hush
              else
                let s ←
                  if f.run_commands
                  then ok voice.Step.TryCommand
                  else ok voice.Step.TryCommandsBackOn
                let steps ← voice.only s
                let waiting ←
                  match o with
                  | none => ok false
                  | some _ => ok true
                if hush
                then alloc.vec.Vec.push steps voice.Step.Hush
                else
                  if waiting
                  then alloc.vec.Vec.push steps voice.Step.Hold
                  else alloc.vec.Vec.push steps voice.Step.Ask
            else
              let s ←
                if f.run_commands
                then ok voice.Step.TryCommand
                else ok voice.Step.TryCommandsBackOn
              let steps ← voice.only s
              let waiting ←
                match o with
                | none => ok false
                | some _ => ok true
              if hush
              then alloc.vec.Vec.push steps voice.Step.Hush
              else
                if waiting
                then alloc.vec.Vec.push steps voice.Step.Hold
                else alloc.vec.Vec.push steps voice.Step.Ask
          | some b =>
            if b
            then voice.only voice.Step.RunWaiting
            else voice.only voice.Step.DeclineWaiting
        else
          let (o, offers_answer) ←
            match f.to_question with
            | none => ok (none, false)
            | some qw =>
              do
              let b ←
                match qw with
                | voice.QuestionWord.YesOrNo => ok false
                | voice.QuestionWord.Answer => ok true
              ok (f.to_question, b)
          let hush ← if f.hush
                       then ok (¬ offers_answer)
                       else ok false
          if hush
          then
            if f.answer_being_written
            then voice.only voice.Step.Hush
            else
              let s ←
                if f.run_commands
                then ok voice.Step.TryCommand
                else ok voice.Step.TryCommandsBackOn
              let steps ← voice.only s
              let waiting ←
                match o with
                | none => ok false
                | some _ => ok true
              if hush
              then alloc.vec.Vec.push steps voice.Step.Hush
              else
                if waiting
                then alloc.vec.Vec.push steps voice.Step.Hold
                else alloc.vec.Vec.push steps voice.Step.Ask
          else
            let s ←
              if f.run_commands
              then ok voice.Step.TryCommand
              else ok voice.Step.TryCommandsBackOn
            let steps ← voice.only s
            let waiting ← match o with
                            | none => ok false
                            | some _ => ok true
            if hush
            then alloc.vec.Vec.push steps voice.Step.Hush
            else
              if waiting
              then alloc.vec.Vec.push steps voice.Step.Hold
              else alloc.vec.Vec.push steps voice.Step.Ask

